# Modèle de configuration des secrets.
# Copiez ce fichier en « script.env » dans le même dossier puis renseignez les valeurs.
# script.env est ignoré par git (voir .gitignore) et ne doit jamais être committé.

export HARMONY_CONNECTOR_CLIENT_ID=''
export HARMONY_CONNECTOR_CLIENT_SECRET=''

export LEGALREF_CLIENT_ID=''
export LEGALREF_CLIENT_SECRET=''

# Base de donnees Neon (PostgreSQL) : source des mappings client / SIREN.
# Chaine de connexion complete (postgresql://user:password@host/db?...).
export NEON_DATABASE_URL=''
